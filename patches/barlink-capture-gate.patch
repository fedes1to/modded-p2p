+    with _poll_gate:
+        # Re-check under the gate: the capture side increments the depth and
+        # then takes this gate, so either this poll runs entirely before the
+        # capture starts, or it sees the pause here and skips.
+        if polling_paused():
+            return 0
+        tripped = 0
+        for transport in registered():
