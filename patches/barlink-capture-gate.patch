+#: Serializes "a poll is on the device" against the capture exclusion. The
+#: capture side increments _capture_depth, then waits for this gate; a poll
+#: holds it while it reads and re-checks polling_paused() after acquiring it.
+#: Without the gate, a poll already inside poll_status_word() when the capture
+#: starts still synchronizes its private stream and invalidates the capture.
+_poll_gate = threading.Lock()
 
 
 class _PausePolling:
@@ -302,6 +308,11 @@ class _PausePolling:
         global _capture_depth
         with _capture_lock:
             _capture_depth += 1
+        # Wait for a poll that is already reading a device. A poll that starts
+        # after the increment sees polling_paused() under the same gate and
+        # skips, so the capture begins with no poll in flight.
+        with _poll_gate:
+            pass
         return self
 
     def __exit__(self, *exc) -> None:
