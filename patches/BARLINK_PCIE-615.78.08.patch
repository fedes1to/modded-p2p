+    // BARLINK_PCIE: FB physical offset the static mapping starts at. The
+    // window covers FB [staticBar1FbBase, staticBar1FbBase + staticBar1Size).
+    NvU64  staticBar1FbBase;
     NvU32  heapStart;          // The start offset of heap in KB, helpful for MIG
                                // systems
 } UvmGpuFbInfo;
