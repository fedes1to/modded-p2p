+//               attached GPU. No static BAR1 required.
+//               This is what the dma-buf path needs: the exporting GPU maps
+//               the exported buffer into its BAR1 on demand
+//               (rm_dma_buf_map_mem_handle -> kbusMapFbAperture_HAL,
+//               arch/nvalloc/unix/src/osapi.c:5797), so the resulting bus
+//               address is somewhere in BAR1 and not in any fixed window.
+#define NV_REG_STR_BARLINK_PEER_BAR1_DISABLE              0x00000000
+#define NV_REG_STR_BARLINK_PEER_BAR1_ENABLE               0x00000001
+
