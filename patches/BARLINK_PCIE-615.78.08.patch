+/*!
+ * @brief BARLINK_PCIE: lowest FB offset that a client allocation can land on
+ *
+ * A window that covers FB the client never gets is useless. Which FB a client
+ * can get is decided by the FB region table: _pmaInitFbRegions
+ * (gpu/mem_mgr/mem_mgr.c) registers a region with PMA only if it is neither
+ * bInternalHeap nor bRsvdRegion; everything else is skipped and can never be
+ * returned by cudaMalloc. The regions below the first PMA region are the
+ * console / display / link training reservations.
+ *
+ * The table must not be hardcoded: on GSP GPUs it is built from the firmware
+ * region list in memmgrInitBaseFbRegions_FWCLIENT
+ * (gpu/mem_mgr/mem_mgr_gsp_client.c), so it depends on board, VBIOS and GSP
+ * version. It is therefore read here at runtime.
+ *
+ * Ordering, checked in this tree:
+ *   - memmgrStatePreInitLocked_IMPL (gpu/mem_mgr/mem_mgr.c:365) calls
+ *     memmgrInitFbRegions() for GSP clients, which fills base/limit and
+ *     bRsvdRegion from the GSP static info.
+ *   - memmgrStateInitLocked_IMPL (gpu/mem_mgr/mem_mgr.c) reserves the console
+ *     region and then calls memmgrCreateHeap() -> heapInit()
+ *     (gpu/mem_mgr/heap.c:544) -> memmgrRegionSetupForPma() ->
+ *     memmgrRegionSetupCommon_IMPL (gpu/mem_mgr/mem_mgr_regions.c:282), which
+ *     sets bInternalHeap.
+ *   - kbusInitBar1_GM107, from which this code runs, is called by
+ *     kbusStatePostLoad_GM107 (gpu/bus/arch/maxwell/kern_bus_gm107.c:692).
+ *     STATE_POST_LOAD runs after STATE_INIT for all engines
+ *     (gpuStateLoad_IMPL -> gpuStatePostLoad, gpu/gpu.c:2689).
+ * So both flags are final by the time this function runs. If the table is
+ * nevertheless empty, this is reported and 0 is returned.
+ *
+ * @param[in]  pGpu
+ * @param[in]  pKernelBus
+ * @param[out] pbFromRegkey  set if the value came from
+ *                           NV_REG_STR_RM_STATIC_BAR1_FB_BASE_MB
+ *
+ * @return FB offset in bytes, aligned up to 2 MiB
+ */
+static NvU64
+_kbusGetStaticBar1FbBase_TU102
+(
+    OBJGPU     *pGpu,
+    KernelBus  *pKernelBus,
+    NvBool     *pbFromRegkey
+)
+{
+    MemoryManager *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    NvU64          requestedBase  = KBUS_STATIC_BAR1_FB_BASE_REQ(pKernelBus);
+    NvU64          fbBase         = 0;
+    NvBool         bFound         = NV_FALSE;
+    NvU32          i;
+
+    if (pbFromRegkey != NULL)
+    {
+        *pbFromRegkey = NV_FALSE;
+    }
+
+    if (pKernelBus->staticBar1FbBaseMB == NV_REG_STR_RM_STATIC_BAR1_FB_BASE_MB_FORCE_ZERO)
+    {
+        //
+        // Explicit request for the old behaviour (window at FB offset 0) so
+        // the two placements can be compared without rebuilding.
+        //
+        if (pbFromRegkey != NULL)
+        {
+            *pbFromRegkey = NV_TRUE;
+        }
+
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: static BAR1 FB base forced to 0 by regkey "
+                  "RMStaticBar1FbBaseMB=0x%x. The window then covers the "
+                  "console/display reservation, which PMA never hands out.\n",
+                  pKernelBus->staticBar1FbBaseMB);
+
+        return 0;
+    }
+
+    if (requestedBase != 0)
+    {
+        fbBase = NV_ALIGN_UP64(requestedBase, RM_PAGE_SIZE_2M);
+
+        if (pbFromRegkey != NULL)
+        {
+            *pbFromRegkey = NV_TRUE;
+        }
+
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: static BAR1 FB base 0x%llx from regkey "
+                  "RMStaticBar1FbBaseMB=%u\n",
+                  fbBase, pKernelBus->staticBar1FbBaseMB);
+
+        return fbBase;
+    }
+
+    if ((pMemoryManager == NULL) || (pMemoryManager->Ram.numFBRegions == 0))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: FB region table not available at static BAR1 setup "
+                  "(pMemoryManager %p, numFBRegions %u), falling back to FB base 0. "
+                  "The window will most likely not be usable for client data.\n",
+                  pMemoryManager,
+                  (pMemoryManager != NULL) ? pMemoryManager->Ram.numFBRegions : 0);
+        return 0;
+    }
+
+    for (i = 0; i < pMemoryManager->Ram.numFBRegions; i++)
+    {
+        const FB_REGION_DESCRIPTOR *pRegion = &pMemoryManager->Ram.fbRegion[i];
+
+        //
+        // Same predicate as _pmaInitFbRegions in gpu/mem_mgr/mem_mgr.c:
+        // internal or reserved regions are never registered with PMA.
+        //
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: fbRegion[%u] base 0x%llx limit 0x%llx rsvdSize 0x%llx "
+                  "bRsvdRegion %u bInternalHeap %u%s\n",
+                  i, pRegion->base, pRegion->limit, pRegion->rsvdSize,
+                  pRegion->bRsvdRegion, pRegion->bInternalHeap,
+                  (!bFound && !pRegion->bRsvdRegion && !pRegion->bInternalHeap) ?
+                      "  <- first PMA region" : "");
+
+        if (bFound || pRegion->bRsvdRegion || pRegion->bInternalHeap)
+        {
+            continue;
+        }
+
+        fbBase = pRegion->base;
+        bFound = NV_TRUE;
+    }
+
+    if (!bFound)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: no FB region is free of bRsvdRegion/bInternalHeap, "
+                  "falling back to FB base 0\n");
+        return 0;
+    }
+
+    fbBase = NV_ALIGN_UP64(fbBase, RM_PAGE_SIZE_2M);
+
+    NV_PRINTF(LEVEL_ERROR,
+              "BARLINK_PCIE: static BAR1 FB base 0x%llx from FB region table "
+              "(%u regions)\n",
+              fbBase, pMemoryManager->Ram.numFBRegions);
+
+    return fbBase;
+}
+
+/*!
+ * @brief BARLINK_PCIE: does one chunk of a memdesc fall inside the window
+ *
+ * The window covers FB [fbBase, fbBase + winSize). Written with subtraction
+ * only so it cannot underflow or overflow.
+ */
+static NvBool
+_kbusIsChunkInStaticBar1Window_TU102
+(
+    MEMORY_DESCRIPTOR  *pMemDesc,
+    ADDRESS_TRANSLATION addressTranslation,
+    NvU64               offset,
+    NvU64               chunk,
+    NvU64               fbBase,
+    NvU64               winSize
+)
+{
+    NvU64 physAddr = memdescGetPhysAddr(pMemDesc, addressTranslation, offset);
+
+    if ((physAddr < fbBase) || (chunk > winSize))
+    {
+        return NV_FALSE;
+    }
+
+    return ((physAddr - fbBase) <= (winSize - chunk));
+}
+
+/*!
+ * @brief BARLINK_PCIE: is the memdesc entirely inside the static BAR1 window
+ *
+ * With a window that neither starts at FB offset 0 nor covers the whole FB,
+ * "BAR1 VA = physAddr - fbBase + startOffset" is only defined for physical
+ * addresses inside [fbBase, fbBase + size). Everything else must go through
+ * the dynamic BAR1 region.
+ */
+static NvBool
+_kbusIsInStaticBar1Window_TU102
+(
+    OBJGPU             *pGpu,
+    KernelBus          *pKernelBus,
+    NvU32               gfid,
+    MEMORY_DESCRIPTOR  *pMemDesc,
+    NvBool              bFullScan
+)
+{
+    NvU64               fbBase   = pKernelBus->bar1[gfid].staticBar1.fbBase;
+    NvU64               winSize  = pKernelBus->bar1[gfid].staticBar1.size;
+    OBJVASPACE         *pVAS     = pKernelBus->bar1[gfid].pVAS;
+    ADDRESS_TRANSLATION addressTranslation;
+    NvU64               mapSize;
+    NvU64               pageSize;
+    NvU64               granularity;
+    NvU64               offset;
+    NvU64               lastOffset;
+
+    if ((pMemDesc == NULL) || (pVAS == NULL) || (winSize == 0))
+    {
+        return NV_FALSE;
+    }
+
+    if (memdescGetAddressSpace(pMemDesc) != ADDR_FBMEM)
+    {
+        return NV_FALSE;
+    }
+
+    addressTranslation = VAS_ADDRESS_TRANSLATION(pVAS);
+    mapSize            = memdescGetSize(pMemDesc);
+    pageSize           = memdescGetPageSize(pMemDesc, addressTranslation);
+
+    if (mapSize == 0)
+    {
+        return NV_FALSE;
+    }
+
+    granularity = memdescGetContiguity(pMemDesc, addressTranslation) ?
+                      mapSize : ((pageSize != 0) ? pageSize : RM_PAGE_SIZE);
+
+    if (bFullScan)
+    {
+        for (offset = 0; offset < mapSize; offset += granularity)
+        {
+            if (!_kbusIsChunkInStaticBar1Window_TU102(pMemDesc, addressTranslation,
+                                                      offset,
+                                                      NV_MIN(granularity, mapSize - offset),
+                                                      fbBase, winSize))
+            {
+                return NV_FALSE;
+            }
+        }
+
+        return NV_TRUE;
+    }
+
+    //
+    // Quick variant: first and last chunk only. Used on the allocation hot
+    // path (kbusIncreaseStaticBar1Refcount_TU102), where walking every page
+    // of a large discontiguous memdesc would be pointlessly expensive. The
+    // authoritative full check happens in _kbusUpdateStaticBar1VAMapping_TU102,
+    // which has to walk every page anyway, and in kbusGetStaticFbAperture_TU102.
+    //
+    lastOffset = RM_ALIGN_DOWN(mapSize - 1, granularity);
+
+    return _kbusIsChunkInStaticBar1Window_TU102(pMemDesc, addressTranslation, 0,
+                                                NV_MIN(granularity, mapSize),
+                                                fbBase, winSize) &&
+           _kbusIsChunkInStaticBar1Window_TU102(pMemDesc, addressTranslation,
+                                                lastOffset, mapSize - lastOffset,
+                                                fbBase, winSize);
+}
+
+/*!
+ * @brief BARLINK_PCIE: determine the size of the static BAR1 window
+ *
+ * If BAR1 is large enough for the client-visible FB above fbBase, all of it
+ * is mapped as before. If it is not, a window is mapped:
+ *
+ *   window = BAR1 VA (2M aligned down) - bar1Offset - safety margin
+ *
+ * safety margin = UserD mappings for all channels + MMIO priv + doorbell
+ *                 + KBUS_STATIC_BAR1_DYNAMIC_RESERVE
+ * These are the same items the AUTO branch of
+ * kbusIsStaticBar1Supported_TU102 adds up, plus the fixed reserve for the
+ * dynamic BAR1 region.
+ *
+ * The result is aligned down to RM_PAGE_SIZE_2M (static BAR1 is mapped
+ * with 2 MiB pages). If it falls below KBUS_STATIC_BAR1_MIN_WINDOW_SIZE,
+ * 0 is returned and the caller rejects static BAR1.
+ *
+ * Both the window size and the dynamic reserve can be overridden at load
+ * time, see NV_REG_STR_RM_STATIC_BAR1_WINDOW_MB and
+ * NV_REG_STR_RM_STATIC_BAR1_RESERVE_MB. An explicit window size is used as
+ * given (aligned down to 2 MiB, capped at the client visible FB size) and
+ * bypasses KBUS_STATIC_BAR1_MIN_WINDOW_SIZE, so values can be swept without
+ * recompiling. It is rejected only if it does not fit into BAR1 behind
+ * bar1Offset.
+ *
+ * The window maps FB starting at fbBase, see _kbusGetStaticBar1FbBase_TU102.
+ *
+ * @param[in] pGpu
+ * @param[in] pKernelBus
+ * @param[in] gfid
+ * @param[in] bar1Offset  start offset of the static region within BAR1
+ * @param[in] fbBase      FB offset the window starts at
+ *
+ * @return size to map in bytes, or 0 if too little space remains
+ */
+static NvU64
+_kbusGetStaticBar1MapSize_TU102
+(
+    OBJGPU     *pGpu,
+    KernelBus  *pKernelBus,
+    NvU32       gfid,
+    NvU64       bar1Offset,
+    NvU64       fbBase
+)
+{
+    MemoryManager *pMemoryManager = GPU_GET_MEMORY_MANAGER(pGpu);
+    KernelFifo    *pKernelFifo    = GPU_GET_KERNEL_FIFO(pGpu);
+    NvU64 clientFbSize = memmgrGetClientFbAddrSpaceSize(pGpu, pMemoryManager);
+    //
+    // BARLINK_PCIE: only the client visible FB above fbBase can be mapped,
+    // everything below is console/display/RM reserved and never handed out.
+    //
+    NvU64 fullMapSize = (clientFbSize > fbBase) ?
+                            RM_ALIGN_DOWN(clientFbSize - fbBase, RM_PAGE_SIZE_2M) : 0;
+    NvU64 bar1VASizeAligned = RM_ALIGN_DOWN(pKernelBus->bar1[gfid].mappableLength,
+                                            RM_PAGE_SIZE_2M);
+    NvU64 dynamicReserve = KBUS_STATIC_BAR1_RESERVE(pKernelBus);
+    NvU64 requestedSize   = KBUS_STATIC_BAR1_WINDOW_REQ(pKernelBus);
+    NvU64 reserved;
+    NvU64 windowSize;
+    NvU64 dynamicAbove;
+    NvU32 userdSize   = 0;
+    NvU32 numChannels = kfifoGetMaxChannelsInSystem(pGpu, pKernelFifo);
+
+    kfifoGetUserdSizeAlign_HAL(pKernelFifo, &userdSize, NULL);
+
+    reserved  = (NvU64)userdSize * numChannels;
+    reserved += 16 * RM_PAGE_SIZE;                  // MMIO priv
+    reserved += 16 * RM_PAGE_SIZE;                  // doorbell
+    reserved += dynamicReserve;
+
+    if (fullMapSize == 0)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: FB base 0x%llx is at or above the client visible FB "
+                  "0x%llx, no static BAR1 window possible\n",
+                  fbBase, clientFbSize);
+        return 0;
+    }
+
+    if (requestedSize != 0)
+    {
+        //
+        // Explicit size from NV_REG_STR_RM_STATIC_BAR1_WINDOW_MB. Honoured as
+        // given so the value can be swept, only capped at the client visible
+        // FB size. KBUS_STATIC_BAR1_MIN_WINDOW_SIZE is deliberately not
+        // applied here.
+        //
+        windowSize = RM_ALIGN_DOWN(requestedSize, RM_PAGE_SIZE_2M);
+
+        if (windowSize > fullMapSize)
+        {
+            windowSize = fullMapSize;
+        }
+
+        if ((windowSize == 0) || ((bar1Offset + windowSize) > bar1VASizeAligned))
+        {
+            NV_PRINTF(LEVEL_ERROR, "BARLINK_PCIE: requested static BAR1 window 0x%llx does not "
+                                   "fit at offset 0x%llx into BAR1 VA 0x%llx\n",
+                                   windowSize, bar1Offset, bar1VASizeAligned);
+            windowSize = 0;
+        }
+    }
+    else if ((bar1Offset + fullMapSize) <= bar1VASizeAligned)
+    {
+        // Everything fits, so map the entire client-visible FB as before
+        windowSize = fullMapSize;
+    }
+    else if ((bar1Offset + reserved) >= bar1VASizeAligned)
+    {
+        windowSize = 0;
+    }
+    else
+    {
+        windowSize = RM_ALIGN_DOWN(bar1VASizeAligned - bar1Offset - reserved,
+                                   RM_PAGE_SIZE_2M);
+
+        if (windowSize > fullMapSize)
+        {
+            windowSize = fullMapSize;
+        }
+
+        if (windowSize < KBUS_STATIC_BAR1_MIN_WINDOW_SIZE)
+        {
+            windowSize = 0;
+        }
+    }
+
+    dynamicAbove = ((windowSize != 0) &&
+                    (bar1VASizeAligned > (bar1Offset + windowSize))) ?
+                       (bar1VASizeAligned - bar1Offset - windowSize) : 0;
+
+    //
+    // LEVEL_ERROR on purpose: these numbers are needed for diagnosis without
+    // raising the debug level.
+    //
+    NV_PRINTF(LEVEL_ERROR,
+              "BARLINK_PCIE: BAR1 VA 0x%llx, client FB 0x%llx, FB base 0x%llx, "
+              "mappable above base 0x%llx, offset 0x%llx, "
+              "userD 0x%llx (%u ch * %u B), reserve 0x%llx, margin 0x%llx, "
+              "window 0x%llx [FB 0x%llx..0x%llx), dynamic below 0x%llx, "
+              "dynamic above 0x%llx\n",
+              bar1VASizeAligned, clientFbSize, fbBase, fullMapSize, bar1Offset,
+              (NvU64)userdSize * numChannels, numChannels, userdSize,
+              dynamicReserve, reserved, windowSize, fbBase, fbBase + windowSize,
+              bar1Offset, dynamicAbove);
+
+    return windowSize;
+}
+
+/*!
+ * @brief BARLINK_PCIE: predict the start offset of the static region in BAR1
+ *
+ * Must match the computation in kbusInitBar1_GM107: align up to 512 MiB
+ * only if the reserve plus the minimum window still fit into BAR1
+ * afterwards, otherwise align up to 2 MiB.
+ *
+ * BARLINK_PCIE: this is purely a BAR1 VA layout question - the console and
+ * mailbox mappings sit at the bottom of BAR1 and the static region follows
+ * them. It does not depend on which FB offset the window maps
+ * (_kbusGetStaticBar1FbBase_TU102), so no fbBase parameter is taken here.
+ * The two are combined in kbusEnableStaticBar1Mapping_TU102:
+ *     BAR1 VA = fbPhysAddr - fbBase + bar1Offset
+ */
+static NvU64
+_kbusGetStaticBar1Offset_TU102
