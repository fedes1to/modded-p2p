diff --git a/src/nvidia/inc/kernel/gpu/bus/kern_bus.h b/src/nvidia/inc/kernel/gpu/bus/kern_bus.h
index afb7d42..8ac4b67 100644
--- a/src/nvidia/inc/kernel/gpu/bus/kern_bus.h
+++ b/src/nvidia/inc/kernel/gpu/bus/kern_bus.h
@@ -1,3 +1,73 @@
 
 #include "g_kern_bus_nvoc.h"
 
+//
+// Static BAR1 window for GPUs with a small BAR1 (BARLINK_PCIE)
+//
+// The official static BAR1 path (Turing+) maps the entire client-visible
+// FB into BAR1. On GPUs whose BAR1 is smaller than the FB (e.g. 256 MiB
+// BAR1 with 10/20 GiB of VRAM, resizable BAR disabled) that is impossible.
+// Instead of rejecting static BAR1 altogether, only a window is mapped in
+// that case. The window starts at the lowest FB offset that PMA can actually
+// hand out (see _kbusGetStaticBar1FbBase_TU102 and
+// NV_REG_STR_RM_STATIC_BAR1_FB_BASE_MB), not at FB offset 0.
+//
+// KBUS_STATIC_BAR1_MIN_WINDOW_SIZE
+//   Smallest window still considered useful. If less than this remains,
+//   static BAR1 is rejected as before.
+//
+// KBUS_STATIC_BAR1_DYNAMIC_RESERVE
+//   BAR1 VA kept for the dynamic region (CPU mappings outside the window,
+//   on-demand BAR1 P2P mappings via dmaAllocBar1P2PMapping, doorbell and
+//   MMIO priv). This reserve is a chosen value, not a measured one.
+//
+#define KBUS_STATIC_BAR1_MIN_WINDOW_SIZE    (64ULL << 20)
+#define KBUS_STATIC_BAR1_DYNAMIC_RESERVE    (64ULL << 20)
+
+//
+// Both values can be overridden at load time without recompiling, see
+// NV_REG_STR_RM_STATIC_BAR1_WINDOW_MB / NV_REG_STR_RM_STATIC_BAR1_RESERVE_MB
+// in interface/nvrm_registry.h. The regkeys are read in
+// kbusInitRegistryOverrides_IMPL (gpu/bus/kern_bus.c) next to
+// staticBar1ForceType.
+//
+
+// Effective dynamic reserve in bytes (RMStaticBar1ReserveMB, 0 = default)
+#define KBUS_STATIC_BAR1_RESERVE(pKernelBus)                                   \
+    (((pKernelBus)->staticBar1ReserveMB != 0) ?                                \
+        ((NvU64)(pKernelBus)->staticBar1ReserveMB << 20) :                     \
+        KBUS_STATIC_BAR1_DYNAMIC_RESERVE)
+
+// Requested window size in bytes (RMStaticBar1WindowMB, 0 = automatic)
+#define KBUS_STATIC_BAR1_WINDOW_REQ(pKernelBus)                                \
+    ((NvU64)(pKernelBus)->staticBar1WindowMB << 20)
+
+//
+// Requested FB start offset of the window in bytes
+// (RMStaticBar1FbBaseMB, 0 = derive from the FB region table).
+//
+#define KBUS_STATIC_BAR1_FB_BASE_REQ(pKernelBus)                               \
+    ((NvU64)(pKernelBus)->staticBar1FbBaseMB << 20)
+
+//
+// BAR1 VA that must still be available behind the start offset for the
+// 512 MiB align up of the static region to be worth doing. Used identically
+// by kbusInitBar1_GM107 and _kbusGetStaticBar1Offset_TU102.
+//
+#define KBUS_STATIC_BAR1_TAIL_NEED(pKernelBus)                                 \
+    (KBUS_STATIC_BAR1_RESERVE(pKernelBus) +                                    \
+     ((KBUS_STATIC_BAR1_WINDOW_REQ(pKernelBus) != 0) ?                         \
+        KBUS_STATIC_BAR1_WINDOW_REQ(pKernelBus) :                              \
+        KBUS_STATIC_BAR1_MIN_WINDOW_SIZE))
+
+//
+// BARLINK_PCIE: identify a GPU in a log line by RM instance and PCI address.
+// With three GPUs in a rig the RM instance alone is not enough to tell which
+// pair a peer decision belongs to, so every peer log line carries the BDF of
+// both participants.
+//
+#define BARLINK_PCIE_GPU_FMT       "GPU%u[%04x:%02x:%02x.0]"
+#define BARLINK_PCIE_GPU_ARG(pGpu)                                             \
+    gpuGetInstance(pGpu), (NvU32)gpuGetDomain(pGpu),                           \
+    (NvU32)gpuGetBus(pGpu), (NvU32)gpuGetDevice(pGpu)
+
