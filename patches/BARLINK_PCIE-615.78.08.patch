+/**
+ * BARLINK_PCIE: wrapper around _p2pGetCapsStatusInternal.
+ *
+ * This is the one place where the caps are final and go back to the caller,
+ * so this is where they are logged, together with the path they took:
+ *
+ *   capsSource=FORCE_P2P_REGKEY   ForceP2P override, no evaluation happened
+ *   capsSource=PCIE_MAILBOX       GSP-RM answer for the mailbox path
+ *   capsSource=PCIE_BAR1(...)     BAR1 branch, decoupled or mailbox-gated
+ *   capsSource=NVLINK/C2C/...     the respective non-PCIe path
+ *
+ * The individual origins additionally print their own "capsSource=" line.
+ */
+NV_STATUS
+p2pGetCapsStatus
+(
+    NvU32 gpuMask,
+    NvU8 *pP2PWriteCapStatus,
+    NvU8 *pP2PReadCapStatus,
+    NvU8 *pP2PAtomicsCapStatus,
+    P2P_CONNECTIVITY *pConnectivity
+)
+{
+    NV_STATUS   status;
+    const char *pCapsSource = "NONE";
+    NvU32       forceP2POverride = BIF_P2P_NOT_OVERRIDEN;
+
+    status = _p2pGetCapsStatusInternal(gpuMask, pP2PWriteCapStatus,
+                                       pP2PReadCapStatus, pP2PAtomicsCapStatus,
+                                       pConnectivity, &pCapsSource);
+
+    if ((status != NV_OK) || (pP2PWriteCapStatus == NULL) ||
+        (pP2PReadCapStatus == NULL) || (pP2PAtomicsCapStatus == NULL) ||
+        (pConnectivity == NULL))
+    {
+        return status;
+    }
+
+    _barlinkPcieLogVerdict(gpuMask, "FINAL", *pConnectivity, *pP2PReadCapStatus,
+                           *pP2PWriteCapStatus, *pP2PAtomicsCapStatus, pCapsSource);
+
+    //
+    // If ForceP2P is armed, the override short circuits both PCIe helpers, so
+    // it is the real origin of the values no matter which branch reported them.
+    //
+    if (_smallbarP2pIsForceP2POverrideArmed(gpuMask, &forceP2POverride) &&
+        ((*pConnectivity == P2P_CONNECTIVITY_PCIE_PROPRIETARY) ||
+         (*pConnectivity == P2P_CONNECTIVITY_PCIE_BAR1)))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BARLINK_PCIE: p2pCapsVerdict[FINAL] gpuMask=0x%x : NOTE - "
+                  "ForceP2P=0x%x is armed, the values above were supplied by the "
+                  "regkey override, not by an evaluation\n",
+                  gpuMask, forceP2POverride);
