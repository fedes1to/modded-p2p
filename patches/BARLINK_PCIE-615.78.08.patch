+/**
+ * BARLINK_PCIE: is the ForceP2P (NV_REG_STR_CL_FORCE_P2P) override armed for
+ * any GPU in the mask? Used only to attribute the origin of the returned caps
+ * in the log, it has no influence on the decision itself.
+ */
+static NvBool
+_smallbarP2pIsForceP2POverrideArmed
+(
+    NvU32  gpuMask,
+    NvU32 *pOverrideValue
+)
+{
+    OBJGPU *pGpu        = NULL;
+    NvU32   gpuInstance = 0;
+
+    while ((pGpu = gpumgrGetNextGpu(gpuMask, &gpuInstance)) != NULL)
+    {
+        KernelBif *pKernelBif = GPU_GET_KERNEL_BIF(pGpu);
+
+        if ((pKernelBif != NULL) &&
+            (pKernelBif->p2pOverride != BIF_P2P_NOT_OVERRIDEN))
+        {
+            if (pOverrideValue != NULL)
+            {
+                *pOverrideValue = pKernelBif->p2pOverride;
+            }
+            return NV_TRUE;
+        }
+    }
+
+    return NV_FALSE;
+}
+
+/**
+ * BARLINK_PCIE: is static BAR1 actually active on EVERY GPU of the mask?
+ *
+ * This is the gate for the decoupled BAR1 evaluation in p2pGetCapsStatus.
+ * kbusIsStaticBar1Enabled() reflects the state after kbusEnableStaticBar1Mapping
+ * really succeeded, no matter whether static BAR1 got there through the regular
+ * path (RMForceStaticBar1 / PDB default) or through our kernel-only
+ * RMStaticBar1LocalForce. If static BAR1 is off anywhere in the mask this
+ * returns NV_FALSE and the old, untouched code path is taken.
+ */
+static NvBool
+_smallbarP2pIsStaticBar1ActiveForMask
+(
+    NvU32 gpuMask
+)
+{
+    OBJGPU *pGpu        = NULL;
+    NvU32   gpuInstance = 0;
+    NvU32   gpuCount    = 0;
+
+    while ((pGpu = gpumgrGetNextGpu(gpuMask, &gpuInstance)) != NULL)
+    {
+        KernelBus *pKernelBus = GPU_GET_KERNEL_BUS(pGpu);
+
+        if ((pKernelBus == NULL) ||
+            !kbusIsStaticBar1Enabled(pGpu, pKernelBus))
+        {
+            return NV_FALSE;
+        }
+
+        gpuCount++;
+    }
+
+    return (gpuCount > 0);
+}
