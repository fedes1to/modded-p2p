+//               moved off the console region. Only useful for A/B measurements;
+//               on a GPU whose BAR1 does not cover the whole FB the resulting
+//               window contains no memory PMA can hand out.
+#define NV_REG_STR_RM_STATIC_BAR1_FB_BASE_MB_FORCE_ZERO           0xFFFFFFFF
+
+#define NV_REG_STR_RM_STATIC_BAR1_LOCAL_FORCE                    "RMStaticBar1LocalForce"
+// Type DWORD
+// Encoding: same values as NV_REG_STR_RM_FORCE_STATIC_BAR1
+//   0 DISABLE, 1 ENABLE, 2 AUTO
+// Overrides staticBar1ForceType in kernel RM only. Every registry key is
+// packaged by RmPackageRegistry() (arch/nvalloc/unix/src/registry.c) and
+// handed to GSP-RM in _kgspPrepareRegistry() (gpu/gsp/kernel_gsp.c), so
+// setting NV_REG_STR_RM_FORCE_STATIC_BAR1 also reaches the GSP firmware,
+// whose own unpatched kbusIsStaticBar1Supported_TU102 rejects a BAR1 that is
+// smaller than the FB and thereby fails GSP-RM init. GSP-RM does not know
+// this key name and ignores it.
+#define NV_REG_STR_RM_STATIC_BAR1_LOCAL_FORCE_UNSET               0xFFFFFFFF
+
+#define NV_REG_STR_BARLINK_PEER_BAR1                             "BarlinkPeerBar1"
+#define NV_REG_STR_BARLINK_PEER_BAR1_LEGACY                      "RMSmallBarP2PPeerBar1"
+// The LEGACY spelling is the name this key carried before the transport
+// was renamed from HTCCL to barlink. It is read as a fallback only, so a
+// driver already loaded and configured on a rig keeps working; new setups
