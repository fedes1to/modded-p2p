+        case P2P_CONNECTIVITY_PCIE_BAR1:        return "PCIE_BAR1";
+        case P2P_CONNECTIVITY_NVLINK:           return "NVLINK";
+        case P2P_CONNECTIVITY_NVLINK_INDIRECT:  return "NVLINK_INDIRECT";
+        case P2P_CONNECTIVITY_C2C:              return "C2C";
