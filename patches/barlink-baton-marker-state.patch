diff --git a/src/barlink/_compat/jit_kernel/cache_health.py b/src/barlink/_compat/jit_kernel/cache_health.py
index e069fec..703b9ff 100644
--- a/src/barlink/_compat/jit_kernel/cache_health.py
+++ b/src/barlink/_compat/jit_kernel/cache_health.py
@@ -133,6 +133,21 @@ logger = logging.getLogger(__name__)
 
 #: Written while a build is running; removed when it finishes either way.
 MARKER_BUILDING = ".barlink_jit_building"
+
+#: The last line of the in-progress marker. The marker is written BEFORE
+#: torch's build lock is even attempted, so on its own it cannot tell
+#: "compiling" from "queued behind somebody else's lock". ``baton_health``
+#: needs that distinction: a queued waiter must not veto reclaiming an
+#: abandoned lock, or every waiter behind one dead lock keeps every other one
+#: waiting -- measured on vLLM startup, where two ranks sat out the full
+#: 30-minute limit on a lock whose builder had been killed. ``baton_health``
+#: rewrites this line the moment it wins the lock. A marker with no state
+#: line (the fork's two-line spelling, and anything a future writer adds) is
+#: read as ``building``: the conservative answer, which waits rather than
+#: reclaims.
+MARKER_STATE_BUILDING = "building"
+MARKER_STATE_WAITING = "waiting"
+
 #: Written after a successful build. Advisory only -- the artifact is the
 #: truth, so entries built before this change stay valid.
 MARKER_COMPLETE = ".barlink_jit_complete"
@@ -257,6 +272,55 @@ def find_building_marker(path: PathLike) -> Optional[Path]:
     return None
 
 
+def marker_state(path: PathLike) -> str:
+    """The state line of a marker file, or ``""`` when it carries none.
+
+    ``""`` is not "waiting": it is "unknown", and :mod:`baton_health` reads it
+    as ``building`` so that a marker written by a version of this module (or
+    by the fork) that predates the state line keeps its veto. Never raises.
+    """
+    try:
+        lines = Path(path).read_text().split("\n")
+    except OSError:
+        return ""
+    return lines[3].strip() if len(lines) > 3 else ""
+
+
+def mark_building(path: PathLike) -> bool:
+    """Flip THIS process's in-progress marker in ``path`` to ``building``.
+
+    Called by :mod:`baton_health` once the build lock is won -- both by the
+    winner of ``try_acquire`` and by a waiter the baton admitted. Until then
+    the marker says ``waiting``, which is the truth: the process has entered
+    the build path but owns no lock and is compiling nothing. See
+    :data:`MARKER_STATE_BUILDING` for the stall that distinction removes.
+
+    Does nothing when there is no marker, or when the marker belongs to
+    another process: rewriting a peer's marker would disarm the veto that
+    protects a real builder. Never raises -- the state line is one module's
+    input, and a build must never fail over it.
+    """
+    p = Path(path)
+    marker = find_building_marker(p)
+    if marker is None:
+        return False
+    info = _read_marker(marker)
+    if info is None or info[1] != os.getpid():
+        return False
+    try:
+        lines = marker.read_text().split("\n")
+    except OSError:
+        return False
+    host = lines[0] if lines and lines[0].strip() else _hostname()
+    pid = lines[1] if len(lines) > 1 and lines[1].strip() else str(os.getpid())
+    stamp = lines[2] if len(lines) > 2 and lines[2].strip() else str(time.time())
+    try:
+        marker.write_text(f"{host}\n{pid}\n{stamp}\n{MARKER_STATE_BUILDING}\n")
+    except OSError:
+        return False
+    return True
+
+
